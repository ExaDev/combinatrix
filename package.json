{
  "name": "combinatrix",
  "description": "Lazily enumerates every valid combination of option dimensions: the solution set of a finite-domain constraint model, with declarative three-valued constraints written as trilean predicate trees, derived dimensions and conditional activity",
  "version": "2.1.0",
  "dependencies": {
    "trilean": "1.13.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@exadev/build-identity": "3.1.0",
    "@exadev/eslint-config": "3.1.0",
    "@playwright/test": "1.64.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@types/node": "26.6.5",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "publint": "0.3.25",
    "semantic-release": "25.0.9",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*.schema.json": "./schemas/*.schema.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "keywords": [
    "cartesian-product",
    "combinations",
    "combinatorics",
    "constraint-satisfaction",
    "enumeration",
    "test-matrix"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/combinatrix.git"
  },
  "scripts": {
    "build": "tsdown && jiti scripts/generate-json-schema.ts",
    "lint": "eslint . --fix --cache --max-warnings 0",
    "lint:check": "eslint . --cache --max-warnings 0",
    "prepare": "husky",
    "prepublishOnly": "pnpm run lint:check && pnpm run typecheck && pnpm run build && pnpm run test && publint && attw --pack --profile esm-only",
    "release": "semantic-release",
    "site:build": "vite build --config site/vite.config.ts",
    "site:dev": "vite --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json && tsc -p site/tsconfig.json && tsc -p site/tsconfig.worker.json && tsc -p e2e/tsconfig.json"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
